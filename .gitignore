# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# local GitHub and Railway access token (never commit)
/.github-token
/.git-credentials
/.railway-token

# agent instructions stay local — `git add -A` must not sweep them in
/AGENTS.md

# pnpm sandbox-local dirs (see .npmrc)
/.npmrc
/.pnpm-tool
/.pnpm-store
/.pnpm-cache
/.pnpm-state
/.npm-cache
/.cache
/.config
/.data

# playwright
/.browsers
/test-results
/playwright-report

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.pnpm-tool

# Local review scratch files
.tmp-review/
# Screenshots taken for a chat reply (disposable)
.tmp-shots/

# Local pnpm store (the sandbox store is read-only, so the repo carries its own)
.pnpm-store/

# npm cache for the sandbox
.npm-cache/

# Intermediate renders from scripts/render-readme-banner.mjs
/docs/assets/banner/rendered-*.png

# harness files: machine-local, mirrored to nomorenamesstudio/infra (never commit)
/CLAUDE.md
/.dsh/
/.claude/
/.cursor/
/.codex/
/.opencode/
/.agents/
/.clinerules
/.cursorrules
/.github/copilot-instructions.md
